# Copiar este archivo como local.properties (que NO se sube a Git) y completar los valores.
# Android Studio agrega solo la línea sdk.dir.
#
# Datos en Supabase > Project Settings > API:
#   SUPABASE_URL: Project URL, ej: https://xxxxxxxx.supabase.co
#   SUPABASE_KEY: la clave PUBLISHABLE (la que empieza con sb_publishable). NUNCA la secret ni la service_role.
sdk.dir=
SUPABASE_URL=
SUPABASE_KEY=
